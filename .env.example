NODE_ENV=production
PORT=4000

# Clave secreta fuerte (mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=reemplazar_por_clave_secreta_aleatoria_segura

# Orígenes permitidos separados por coma (front y superadmin en producción)
CORS_ORIGINS=https://novacoins.ec,https://admin.novacoins.ec

# Opción A: URL completa de PostgreSQL (recomendada en producción)
# DATABASE_URL=postgres://usuario:clave@host:5432/novacoins
# DB_SSL=true

# Opción B: Parámetros individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novacoins
DB_USER=postgres
DB_PASS=reemplazar_por_clave_postgres

# Bootstrap inicial de cuenta Super Administrador (se usa solo si no existe ninguno)
ADMIN_NAME=Administrador Nova Coins
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PHONE=+593 99 000 0000
ADMIN_PASSWORD=reemplazar_por_clave_segura

# Proveedor Central One Global v1 (solo en servidor, nunca exponer en frontend)
# CO_API_BASE_URL=https://portal.centraloneglobal.com/api/v1
# CO_API_KEY=co_live_reemplazar
# CO_WEBHOOK_SECRET=whsec_reemplazar
